# Copy to .env for running the server outside Docker.
NODE_ENV=development
PORT=5000

# Local Docker MongoDB (docker compose up mongo). In production use your MongoDB Atlas URL.
MONGO_URL=mongodb://localhost:27017/studycircle

# Long random string. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Frontend origin(s) allowed by CORS, comma-separated
CLIENT_ORIGIN=http://localhost:5173

# Optional: cloudinary://<api_key>:<api_secret>@<cloud_name>. Without it, files are stored in ./uploads
CLOUDINARY_URL=

# Optional: create a superadmin when running `npm run seed`
SEED_SUPERADMIN_EMAIL=
SEED_SUPERADMIN_PASSWORD=
